{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:clean": "shx rm -rf dist && vite build",
    "dev": "vite",
    "eslint:check": "eslint . --ext .ts,.tsx",
    "eslint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:fix": "yarn run prettier:fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "tidy": "yarn install && run-s prettier:fix build:clean",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/core": "3.23.2",
    "@tiptap/extension-text": "3.23.2",
    "@tiptap/pm": "3.23.2",
    "@tiptap/react": "3.23.2",
    "dayjs": "^1.11.13",
    "lodash": "^4.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.0",
    "uuid": "^14.0.0",
    "yamprint": "^0.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-jsdoc": "^1.3.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.15",
    "sass": "^1.99.0",
    "shx": "^0.4.0",
    "typescript": "^5.8.3",
    "vite": "^5.0.0"
  },
  "packageManager": "yarn@4.4.0"
}
